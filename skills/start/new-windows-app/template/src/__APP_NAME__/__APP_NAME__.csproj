<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 app. Unpackaged (no MSIX) and self-contained: the exe runs
       without installing the Windows App SDK runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>__APP_NAME__</RootNamespace>
    <AssemblyName>__APP_NAME__</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Builds the app's .pri with the compiled XAML. Without it, dotnet publish
         leaves the XAML out and the installed app crashes at start (0xC000027B). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Version>0.1.0</Version>
    <!-- LibraryImport (Win32 calls) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The exe's icon (Explorer, Start menu). Made from Icon\AppIcon.svg by tools\make-icon.cs. -->
    <ApplicationIcon>..\..\Icon\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- The window's icon (title bar, taskbar), loaded at run time. -->
    <Content Include="..\..\Icon\AppIcon.ico" Link="AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\__APP_NAME__.Kit\__APP_NAME__.Kit.csproj" />
  </ItemGroup>
</Project>
