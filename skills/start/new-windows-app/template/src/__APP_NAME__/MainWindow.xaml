<Window x:Class="__APP_NAME__.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- Without Mica (Windows 10, or APP_NO_MICA=1) the window paints its own theme background here. -->
    <Border x:Name="SolidBackground" Grid.RowSpan="2" Visibility="Collapsed"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
    <!-- The title bar: the app's own content, dragged like the system one. -->
    <Grid x:Name="TitleBarArea" Grid.Row="0">
      <StackPanel Margin="16,0,0,0" Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" VerticalAlignment="Center">
        <Image Source="ms-appx:///AppIcon.ico" Width="16" Height="16" />
        <TextBlock x:Name="TitleText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Nav" Grid.Row="1" IsBackButtonVisible="Collapsed"
                    PaneDisplayMode="Left" IsSettingsVisible="True"
                    SelectionChanged="OnNavSelectionChanged">
      <!-- The items come from NavPages in Navigation.cs (MainWindow constructor). -->
      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</Window>
