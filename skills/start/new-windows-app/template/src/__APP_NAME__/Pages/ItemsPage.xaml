<Page x:Class="__APP_NAME__.Pages.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:__APP_NAME__.Kit.Data"
    xmlns:ui="using:__APP_NAME__.UI">
  <Grid ui:Layout.Area="page">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: the page title on the left, the page's actions on the right. -->
    <Grid x:Name="Header" Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="{StaticResource SpaceLg}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="PageTitle" ui:Layout.Probe="title" ui:Layout.ProbeArea="page" VerticalAlignment="Center" Style="{StaticResource PageTitleTextStyle}" />
      <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsOpen="False">
        <AppBarButton x:Name="NewButton" Command="{x:Bind ViewModel.AddItemCommand}" />
        <AppBarButton x:Name="StarButton" Command="{x:Bind ViewModel.ToggleStarCommand}" />
        <AppBarButton x:Name="DeleteButton" Command="{x:Bind ViewModel.DeleteSelectionCommand}" />
      </CommandBar>
    </Grid>

    <ListView x:Name="List" Grid.Row="1" Padding="8,0,8,24"
              ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="Single"
              SelectionChanged="OnListSelectionChanged" ContextRequested="OnListContextRequested">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="data:Item">
          <Grid ColumnSpacing="{StaticResource SpaceMd}" Padding="0,8,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Title}" ui:Layout.Probe="row" ui:Layout.ProbeArea="page" Style="{StaticResource RowTextStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Title}" />
            <FontIcon Grid.Column="1" Glyph="&#xE735;" FontSize="{StaticResource SpaceLg}"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      Visibility="{x:Bind IsStarred}" AutomationProperties.Name="Starred" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Empty state: what the page is for, and the first action. -->
    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="{StaticResource SpaceMd}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
      <FontIcon Glyph="&#xE8FD;" FontSize="{StaticResource EmptyStateIconSize}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <Button HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
              Content="New item" Command="{x:Bind ViewModel.AddItemCommand}" />
    </StackPanel>
  </Grid>
</Page>
