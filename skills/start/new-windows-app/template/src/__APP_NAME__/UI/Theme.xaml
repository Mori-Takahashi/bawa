<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design tokens. Views use these keys, never raw numbers or colors.
       The accent comes from Windows, or from Settings > Appearance (UI/ThemeStore.cs). -->

  <!-- Spacing: the 4 px scale from UI/Grid.cs -->
  <x:Double x:Key="SpaceXs">4</x:Double>
  <x:Double x:Key="SpaceSm">8</x:Double>
  <x:Double x:Key="SpaceMd">12</x:Double>
  <x:Double x:Key="SpaceLg">16</x:Double>
  <x:Double x:Key="SpaceXl">20</x:Double>
  <x:Double x:Key="SpaceXxl">24</x:Double>
  <x:Double x:Key="SpaceSection">32</x:Double>

  <Thickness x:Key="PageMargin">24,24,24,24</Thickness>
  <Thickness x:Key="PageHeaderMargin">24,24,24,12</Thickness>
  <Thickness x:Key="CardPadding">16,16,16,16</Thickness>
  <Thickness x:Key="RowPadding">12,8,12,8</Thickness>

  <!-- Radii: Windows 11 control and overlay corners -->
  <CornerRadius x:Key="CardRadius">8</CornerRadius>
  <x:Double x:Key="SettingsMaxWidth">1000</x:Double>
  <x:Double x:Key="EmptyStateIconSize">48</x:Double>

  <!-- A card on a page: a raised layer on Mica, like the Settings app -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
  </Style>
</ResourceDictionary>
